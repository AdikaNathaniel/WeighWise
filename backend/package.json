{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build gateway && nest build ingestion && nest build spc-engine && nest build alerting",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/gateway/main",
    "start:gateway:dev": "nest start gateway --watch",
    "start:ingestion:dev": "nest start ingestion --watch",
    "start:spc-engine:dev": "nest start spc-engine --watch",
    "start:alerting:dev": "nest start alerting --watch",
    "start:all:dev": "concurrently -n gateway,ingestion,spc-engine,alerting -c blue,green,yellow,magenta \"npm:start:gateway:dev\" \"npm:start:ingestion:dev\" \"npm:start:spc-engine:dev\" \"npm:start:alerting:dev\"",
    "lint": "oxlint apps/ libs/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@supabase/supabase-js": "^2.116.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^10.0.5",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
