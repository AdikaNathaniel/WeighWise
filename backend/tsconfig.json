{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "baseUrl": "./",
    "paths": {
      "@app/common": ["libs/common/src"],
      "@app/common/*": ["libs/common/src/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/ingestion/tsconfig.app.json"
    },
    {
      "path": "./apps/spc-engine/tsconfig.app.json"
    },
    {
      "path": "./apps/alerting/tsconfig.app.json"
    }
  ]
}